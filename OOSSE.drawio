        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|Ali|\nstart\n:已登录并打开 APU Cafe App;\n\n|System|\n:显示可用菜单;\n\nrepeat\n  |Ali|\n  :选择菜单项;\n\n  |System|\n  if (商品可用?) then (是)\n    :加入订单;\n  else (否)\n    :提示商品不可用;\n  endif\nrepeat while (继续添加?) is (是) not (否)\n\n|Ali|\n:确认订单;\n\n|System|\n:计算总价;\n:应用 5% 学生折扣;\n:显示应付金额;\n\n|Ali|\n:选择 Touch &#39;n Go eWallet;\n\nrepeat\n  |Payment Provider|\n  :处理付款;\n\n  |System|\n  if (支付成功?) then (是)\n    :标记订单为 Paid;\n\n    fork\n      :显示电子收据;\n    fork again\n      :发送订单到厨房;\n    end fork\n\n    |Ali|\n    :到柜台取餐;\n    stop\n  else (否)\n    :提示支付失败;\n\n    |Ali|\n  endif\nrepeat while (重试?) is (是) not (取消)\n\n|System|\n:标记订单为 Cancelled;\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hmRZyM2wxmw2Qo6fpZJD-219">
